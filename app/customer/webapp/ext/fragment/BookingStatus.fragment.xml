<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:mc="sap.suite.ui.microchart">

    <VBox id="_IDGenVBox">
        <mc:ComparisonMicroChart id="_IDGenComparisonMicroChart"
            size="M"
            maxValue="100">

            <mc:data>

                <mc:ComparisonMicroChartData id="_IDGenComparisonMicroChartData1"
                    title="New1"
                    value="20"
                    displayValue="20"
                    color="Critical"/>

                <mc:ComparisonMicroChartData id="_IDGenComparisonMicroChartData2"
                    title="Accepted1"
                    value="60"
                    displayValue="60"
                    color="Good"/>

                <mc:ComparisonMicroChartData id="_IDGenComparisonMicroChartData3"
                    title="Canceled1"
                    value="10"
                    displayValue="10"
                    color="Error"/>

            </mc:data>

        </mc:ComparisonMicroChart>
    </VBox>
</core:FragmentDefinition>